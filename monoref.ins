%%
%% monoref.ins
%% Extract monoref.sty from the .dtx.
%%
%% The Lua backend monoref.lua is shipped as a standalone source
%% file (a docstrip %%-header would be invalid Lua), so it is NOT
%% generated here -- install it alongside the .sty.
