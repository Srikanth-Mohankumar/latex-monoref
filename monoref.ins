%% Released under the LaTeX Project Public License v1.3c or later.
%%
\input docstrip.tex
\keepsilent

\usedir{tex/lualatex/monoref}

\preamble

This is a generated file.

Copyright (C) 2025 Srikanth Mohankumar <srikanthmohankumar@gmail.com>

This work may be distributed and/or modified under the conditions of
the LaTeX Project Public License, either version 1.3c of this license
or (at your option) any later version.  The latest version of this
license is in http://www.latex-project.org/lppl.txt and version 1.3c
or later is part of all distributions of LaTeX version 2008 or later.

This work has the LPPL maintenance status `maintained'.
The Current Maintainer of this work is Srikanth Mohankumar.

\endpreamble

\postamble

End of file `\outFileName'.
\endpostamble

\generate{%
  \file{monoref.sty}{\from{monoref.dtx}{package}}%
}

\obeyspaces
\Msg{*****************************************************************}
\Msg{* monoref: generated monoref.sty                *}
\Msg{*                                                               *}
\Msg{* Install BOTH of these where LuaLaTeX can find them, e.g.      *}
\Msg{*   TEXMFHOME/tex/lualatex/monoref/                     *}
\Msg{*     monoref.sty   (generated here)                    *}
\Msg{*     monoref.lua   (shipped standalone)                *}
\Msg{* then run:  mktexlsr                                           *}
\Msg{*****************************************************************}

\endbatchfile
